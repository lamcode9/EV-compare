// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Country {
  SG
  MY
  ID
  PH
  TH
  VN
}

enum BatteryTechnology {
  NMC
  LFP
  SolidState
  Other
}

model Vehicle {
  id                          String            @id @default(uuid())
  country                     Country
  name                        String
  modelTrim                   String?
  imageUrl                    String?
  batteryWeightKg             Float?
  curbWeightKg                Float?
  batteryWeightPercentage     Float?
  powerRatingKw               Float?
  powerRatingExplanation      String?
  torqueNm                    Float?            // Torque in Newton meters (Nm)
  acceleration0To100Kmh       Float?            // 0-100 km/h in seconds (≈ 0-60 mph)
  topSpeedKmh                 Float?            // Top speed in km/h
  efficiencyKwhPer100km       Float?
  rangeKm                     Float?              // Legacy field, use rangeWltpKm or rangeEpaKm
  rangeWltpKm                 Float?             // WLTP range in km
  rangeEpaKm                  Float?             // EPA range in km
  batteryCapacityKwh          Float?             // Battery capacity in kWh
  manufacturerCostUsd         Float?
  batteryManufacturer         String?
  batteryTechnology           BatteryTechnology?
  batteryWarranty             String?          // Battery warranty description (e.g., "8 years / 160,000 km")
  chargingTimeDc0To80Min      Int?
  chargingCapabilities        String?
  hasBidirectional            Boolean?         // Bidirectional charging (V2L/V2H) capability
  technologyFeatures          String?          // Technology features description (e.g., "Autopilot, Sentry Mode, Dog Mode")
  otaUpdates                  String?          // Over the Air (OTA) Updates: "Yes", "No", or "N/A"
  basePriceLocalCurrency      Float?
  optionPrices                Json             // Array of {name: string, price: number}
  onTheRoadPriceLocalCurrency Float?
  rebates                     Json             // Array of {name: string, amount: number, description: string}
  isAvailable                 Boolean          @default(true)
  dataSourceUrl               String?          // URL of the primary data source
  dataLastVerified            DateTime?        // When data was last manually verified
  updatedAt                   DateTime         @updatedAt
  createdAt                   DateTime         @default(now())

  priceSnapshots              PriceSnapshot[]

  @@index([country, isAvailable])
  @@index([name])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // "CREATE", "UPDATE", "DELETE"
  vehicleId   String?
  vehicleName String?
  changes     Json?    // Store what changed
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model PriceSnapshot {
  id           String   @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  basePrice    Float    // basePriceLocalCurrency at snapshot time
  otrPrice     Float?   // onTheRoadPriceLocalCurrency at snapshot time
  currency     String   // Currency code (SGD, MYR, etc.)
  source       String?  // Source URL for this price point
  snapshotDate DateTime @default(now())

  @@index([vehicleId, snapshotDate])
  @@index([snapshotDate])
}

model Correction {
  id             String   @id @default(uuid())
  type           String   // "ev" or "bess"
  country        Country
  itemName       String   // Vehicle name or BESS product name
  field          String   // Field being corrected
  currentValue   String   // Current value in database
  suggestedValue String   // Suggested correction
  source         String?  // Source URL
  email          String?  // Contact email
  notes          String?  // Additional notes
  status         String   @default("pending") // "pending", "approved", "rejected"
  reviewedAt     DateTime?
  reviewedBy     String?
  createdAt      DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  country      String?  // Optional: which country they care about
  subscribedAt DateTime @default(now())
  confirmed    Boolean  @default(false)
  unsubscribed Boolean  @default(false)

  @@index([email])
  @@index([subscribedAt])
}

